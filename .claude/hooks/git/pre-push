#!/bin/sh
# Git for Windows runs hooks with its own sh.exe: this file hands the push to Git LFS and to PowerShell.
input=$(cat)
if command -v git-lfs >/dev/null 2>&1; then
  printf '%s\n' "$input" | git lfs pre-push "$@" || exit $?
fi
printf '%s\n' "$input" | powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(dirname "$0")/pre-push.ps1"
